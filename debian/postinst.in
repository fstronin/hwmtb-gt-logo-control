#!/bin/sh
set -e

# DKMS_VERSION is substituted at build time from debian/changelog
DKMS_NAME=hwlogo
DKMS_VERSION=@VERSION@

case "$1" in
configure)
	# build + sign (with the machine's enrolled MOK key) + install for all
	# installed kernels, using DKMS' own helper
	if [ -x /usr/lib/dkms/common.postinst ]; then
		/usr/lib/dkms/common.postinst "$DKMS_NAME" "$DKMS_VERSION" "" "" "$2"
	fi

	if command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules || true
		udevadm trigger --subsystem-match=leds || true
	fi

	if ! modprobe "$DKMS_NAME" 2>/dev/null; then
		echo "hwlogo: WARNING: module could not be loaded - the firmware method" >&2
		echo "hwlogo: \\_SB.PC00.LPCB.HWEC.ECCD may not exist on this machine." >&2
	fi
	;;
abort-upgrade|abort-remove|abort-deconfigure)
	;;
*)
	echo "hwlogo postinst called with unknown argument '$1'" >&2
	exit 1
	;;
esac

exit 0
